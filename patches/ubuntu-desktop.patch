diff --git a/apps/desktop/scripts/linux-update-publish.mjs b/apps/desktop/scripts/linux-update-publish.mjs
new file mode 100644
index 00000000..b1612953
--- /dev/null
+++ b/apps/desktop/scripts/linux-update-publish.mjs
@@ -0,0 +1,19 @@
+/** Resolve the Ubuntu feed independently from DeepSeek's Windows/macOS release service. */
+
+/**
+ * Validate a generic feed used by electron-updater's Debian package updater.
+ * @param {NodeJS.ProcessEnv} environment - Packaging inputs; loopback HTTP is reserved for local qualification.
+ * @returns {{ provider: 'generic', url: string, channel: 'stable', useMultipleRangeRequest: false } | undefined} Explicit Ubuntu feed, or no online update source.
+ */
+export function linuxUpdatePublish(environment) {
+  const value = environment.DSH_DESKTOP_LINUX_UPDATE_URL
+  if (value === undefined) return undefined
+  const url = new URL(value)
+  const localTest = environment.DSH_DESKTOP_LINUX_UPDATE_TEST === '1'
+    && url.protocol === 'http:' && ['127.0.0.1', '[::1]'].includes(url.hostname)
+  if ((!localTest && url.protocol !== 'https:') || url.username || url.password || url.search || url.hash) {
+    throw new Error('Ubuntu update source must be an HTTPS URL without credentials, query or fragment')
+  }
+  url.pathname = `${url.pathname.replace(/\/+$/u, '')}/`
+  return { provider: 'generic', url: url.href, channel: 'stable', useMultipleRangeRequest: false }
+}
diff --git a/apps/desktop/scripts/package-linux.mjs b/apps/desktop/scripts/package-linux.mjs
new file mode 100644
index 00000000..49f6ff41
--- /dev/null
+++ b/apps/desktop/scripts/package-linux.mjs
@@ -0,0 +1,35 @@
+/** Build a locally maintained Ubuntu package with upstream dependency and runtime checks. */
+import { spawnSync } from 'node:child_process'
+import { mkdirSync } from 'node:fs'
+import { resolve } from 'node:path'
+import { parseArgs } from 'node:util'
+import { desktopTargetBuildPaths } from './desktop-build-paths.mjs'
+
+const root = resolve(import.meta.dirname, '../../..')
+const app = resolve(root, 'apps/desktop')
+const { values } = parseArgs({ options: { 'skip-build': { type: 'boolean', default: false } } })
+if (process.platform !== 'linux' || process.arch !== 'x64') throw new Error('Ubuntu packaging requires a Linux x64 host')
+if (!process.env.npm_execpath) throw new Error('Run through pnpm run package:linux:x64')
+const env = { ...process.env, DSH_GATE_CONCURRENCY: process.env.DSH_GATE_CONCURRENCY ?? '2',
+  DSH_DESKTOP_UNSIGNED: '1', DSH_DESKTOP_APP_ID: 'local.deepseek.harness',
+  DSH_DESKTOP_TARGET_PLATFORM: 'linux', DSH_DESKTOP_TARGET_ARCH: 'x64' }
+const paths = desktopTargetBuildPaths('linux-x64')
+function run(args, cwd = root) {
+  console.log(`Ubuntu package: ${args.join(' ')}`)
+  const result = spawnSync(process.execPath, [process.env.npm_execpath, ...args], { cwd, env, stdio: 'inherit' })
+  if (result.error) throw result.error
+  if (result.status !== 0) throw new Error(`Ubuntu package stage failed (${result.status ?? result.signal}): ${args.join(' ')}`)
+}
+if (!values['skip-build']) run(['run', 'build', '--profile', 'local'])
+run(['exec', 'tsx', 'apps/desktop/scripts/pack-local-packages.ts', '--out', paths.packedDsh, '--concurrency', '4'])
+run(['--dir', 'apps/desktop-host', 'pack', '--pack-destination', paths.packedDsh])
+run(['run', 'release:pack', '--family', 'vendor', '--out', paths.packedVendor, '--concurrency', '4'])
+mkdirSync(paths.packedLandlock, { recursive: true })
+run(['--dir', 'native/system', 'run', 'build:ts'])
+run(['--dir', 'native/system/packages/entry', 'pack', '--pack-destination', paths.packedLandlock])
+run(['run', 'prepare:runtime'], app)
+run(['run', 'prepare:packages'], app)
+run(['run', 'prepare:dsh'], app)
+run(['exec', 'electron-builder', '--config', 'electron-builder.linux.config.mjs', '--linux', 'deb', '--x64', '--publish', 'never'], app)
+run(['exec', 'tsx', 'scripts/smoke-packaged-runtime.ts', '--unsigned'], app)
+console.log(`Ubuntu package available under ${paths.unsignedArtifacts}`)
