index 00000000..4ad29ccd
--- /dev/null
+++ b/apps/desktop/tests/fixtures/linux-updater.mjs
@@ -0,0 +1,102 @@
+/** Real Debian updater transport checks; no package installation is performed. */
+import assert from 'node:assert/strict'
+import { createHash } from 'node:crypto'
+import { once } from 'node:events'
+import { createServer } from 'node:http'
+import { mkdtemp, writeFile, rm, readFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { app } from 'electron'
+import updaterModule from 'electron-updater'
+import { DesktopUpdateCoordinator } from '../../lib/types/update-coordinator.js'
+import { DesktopUpdateHttpExecutor } from '../../lib/types/updates/electron-updater/http-executor.js'
+
+async function main() {
+  console.log('Ubuntu updater: fixture started')
+  const deadline = setTimeout(() => { console.error('Ubuntu updater: qualification exceeded 45 seconds'); app.exit(1) }, 45000)
+  const root = await mkdtemp(join(tmpdir(), 'dsh-ubuntu-update-'))
+  app.setPath('userData', root)
+  app.on('window-all-closed', () => {})
+  const payload = Buffer.alloc(64 * 1024, 0x55)
+  const sha512 = createHash('sha512').update(payload).digest('base64')
+  let version = '1.0.1'
+  let mode = 'healthy'
+  const requests = []
+  const server = createServer((req, res) => {
+    const path = new URL(req.url, 'http://127.0.0.1').pathname
+    requests.push(path)
+    if (path === '/stable-linux.yml') {
+      if (mode === 'missing') { res.writeHead(404).end(); return }
+      res.end(JSON.stringify({ version, files: [{ url: 'payload.deb', size: payload.length, sha512 }], path: 'payload.deb', sha512 }))
+    } else if (path === '/payload.deb') {
+      res.writeHead(200, { 'Content-Length': payload.length })
+      res.end(mode === 'corrupt' ? Buffer.alloc(payload.length, 0x44) : payload)
+    } else res.writeHead(404).end()
+  })
+  let coordinator
+  try {
+    await app.whenReady()
+    console.log('Ubuntu updater: Electron ready')
+    await new Promise(resolve => server.listen(0, '127.0.0.1', resolve))
+    const config = join(root, 'app-update.yml')
+    await writeFile(config, 'updaterCacheDirName: ubuntu-update-test\n')
+    const forbidden = () => { throw new Error('Unexpected process restart or package installation') }
+    const updater = new updaterModule.DebUpdater(undefined, {
+      version: '1.0.0', name: 'ubuntu-update-test', isPackaged: true,
+      appUpdateConfigPath: config, userDataPath: root, baseCachePath: root,
+      whenReady: async () => {}, quit: forbidden, relaunch: forbidden, onQuit: forbidden,
+    })
+    updater.logger = null
+    updater.httpExecutor = new DesktopUpdateHttpExecutor(2000)
+    updater.setFeedURL({ provider: 'generic', url: `http://127.0.0.1:${server.address().port}/` })
+    let consent = false
+    let installations = 0
+    updater.quitAndInstall = (silent, restart) => { assert.equal(silent, true); assert.equal(restart, true); installations++ }
+    const states = []
+    coordinator = new DesktopUpdateCoordinator(state => { states.push(state); return state }, async () => consent,
+      updater, () => true, () => '1.0.0', undefined, 'stable')
+    console.log('Ubuntu updater: checking missing feed')
+    mode = 'missing'
+    assert.equal((await coordinator.check(true)).failedOperation, 'check')
+    console.log('Ubuntu updater: checking version order')
+    mode = 'healthy'; version = '0.9.0'
+    assert.equal((await coordinator.check(true)).phase, 'idle')
+    version = '1.0.0'
+    assert.equal((await coordinator.check(true)).phase, 'idle')
+    version = '1.0.1'
+    assert.equal((await coordinator.check(true)).phase, 'available')
+    console.log('Ubuntu updater: checking corrupted download')
+    mode = 'corrupt'
+    assert.equal((await coordinator.download(version)).failedOperation, 'download')
+    console.log('Ubuntu updater: checking recovered download')
+    mode = 'healthy'
+    assert.equal((await coordinator.check(true)).phase, 'available')
+    assert.equal((await coordinator.download(version)).phase, 'ready')
+    const downloaded = updater.downloadedUpdateHelper.file
+    assert.deepEqual(await readFile(downloaded), payload)
+    assert.equal((await coordinator.install(version)).phase, 'ready')
+    assert.equal(installations, 0)
+    consent = true
+    assert.equal((await coordinator.install(version)).phase, 'installing')
+    assert.equal(installations, 1)
+    assert.ok(requests.includes('/stable-linux.yml'))
+    assert.ok(requests.includes('/payload.deb'))
+    await writeFile(process.env.DSH_UBUNTU_UPDATE_RESULT, JSON.stringify({
+      updater: 'DebUpdater', check: true, noDowngrade: true, networkFailureRecovery: true,
+      corruptDownloadRejected: true, verifiedDownload: true, consentRequired: true,
+      installRestartHandoff: true, actualSystemInstallation: false,
+      states: states.map(s => s.phase),
+    }, null, 2) + '\n')
+    console.log('Ubuntu updater transport, integrity, consent and restart handoff passed')
+  } finally {
+    coordinator?.dispose()
+    server.closeAllConnections()
+    if (server.listening) { server.close(); await once(server, 'close') }
+    await rm(root, { recursive: true, force: true })
+    clearTimeout(deadline)
+    app.quit()
+  }
+
+}
+
+void main().catch(error => { console.error(error); app.exit(1) })
