+import type { DesktopElectronBuilderConfig } from './electron-builder.config.mjs'
+
+/** Ubuntu additions to the upstream desktop package configuration. */
+declare const config: Omit<DesktopElectronBuilderConfig, 'extraMetadata'> & {
+  readonly electronDist: string
+  readonly extraMetadata: { readonly dshDesktopAppId: string; readonly dshMandatoryUpdatePolicy?: never }
+  readonly linux: {
+    readonly target: readonly string[]
+    readonly desktop: { readonly entry: { readonly MimeType: string } }
+  }
+}
+export default config
diff --git a/apps/desktop/electron-builder.linux.config.mjs b/apps/desktop/electron-builder.linux.config.mjs
new file mode 100644
index 00000000..1fe84b2e
--- /dev/null
+++ b/apps/desktop/electron-builder.linux.config.mjs
@@ -0,0 +1,53 @@
+/** Ubuntu packages reuse the upstream runtime and omit the official release service. */
+import { createElectronBuilderConfig } from './scripts/electron-builder-config.mjs'
+import { linuxUpdatePublish } from './scripts/linux-update-publish.mjs'
+
+const config = createElectronBuilderConfig({
+  ...process.env,
+  DSH_DESKTOP_APP_ID: 'local.deepseek.harness',
+  DSH_DESKTOP_UNSIGNED: '1',
+  DSH_DESKTOP_TARGET_PLATFORM: 'linux',
+  DSH_DESKTOP_TARGET_ARCH: 'x64',
+})
+// The Linux Host uses standalone Node to avoid Electron's GLib conflict with sharp.
+const dsh = config.files.find(entry => typeof entry === 'object' && entry.to === 'dsh').from
+config.files = config.files.filter(entry => typeof entry === 'string')
+config.extraResources.push(
+  { from: dsh, to: 'dsh', filter: ['**/*'] },
+  { from: `${dsh}/node_modules`, to: 'dsh/node_modules', filter: ['**/*'] },
+)
+const verifyPreparedRuntime = config.afterPack
+config.afterPack = async context => {
+  await verifyPreparedRuntime(context)
+  const { verifyDesktopRuntime, readDesktopRuntime } = await import('./lib/types/runtime-tree.js')
+  const resources = context.packager.getResourcesDir(context.appOutDir)
+  await verifyDesktopRuntime(`${resources}/dsh`, readDesktopRuntime(dsh).release.version, { platform: 'linux', arch: 'x64' })
+}
+const update = linuxUpdatePublish(process.env)
+config.publish = update === undefined ? null : [update]
+config.generateUpdatesFilesForAllChannels = true
+config.productName = 'DeepSeek Harness'
+config.extraMetadata = { ...config.extraMetadata, name: 'deepseek-harness', desktopName: 'deepseek-harness.desktop', dshDesktopUpdateChannel: 'stable', homepage: 'https://github.com/deepseek-ai/deepseek-harness' }
+config.linux = {
+  executableName: 'deepseek-harness',
+  syncDesktopName: true,
+  executableArgs: ['--enable-wayland-ime', '--wayland-text-input-version=3'],
+  icon: 'resources/icon-linux.png',
+  category: 'Development',
+  target: ['deb'],
+  maintainer: 'Local Ubuntu Build <local@localhost>',
+  desktop: { entry: {
+    Name: 'DeepSeek Harness',
+    'Name[zh_CN]': 'DeepSeek Harness',
+    Comment: 'DeepSeek Harness agent workspace',
+    'Comment[zh_CN]': 'DeepSeek Harness 智能体工作台',
+    StartupWMClass: 'deepseek-harness',
+    MimeType: 'x-scheme-handler/dsh;',
+  } },
+}
+config.deb = { depends: [
+  'libgtk-3-0t64 | libgtk-3-0', 'libnss3', 'libasound2t64 | libasound2', 'libgbm1',
+  'libnotify4', 'libsecret-1-0', 'libxtst6', 'libxss1', 'xdg-utils', 'zenity',
+], compression: 'xz' }
+config.artifactName = 'deepseek-harness-${version}-ubuntu-${arch}-local.${ext}'
+export default config
