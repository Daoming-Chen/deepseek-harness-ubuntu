+/** Qualify the real Debian updater without installing software or using provider credentials. */
+import { spawn } from 'node:child_process'
+import { mkdtemp, readFile, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join, resolve } from 'node:path'
+import { resolveDesktopTargetBuildPaths } from './desktop-build-paths.mjs'
+
+if (process.platform !== 'linux') throw new Error('Debian updater qualification requires Linux')
+const root = await mkdtemp(join(tmpdir(), 'ubuntu-updater-qualification-'))
+const result = join(root, 'result.json')
+const child = spawn(join(resolveDesktopTargetBuildPaths().electron, 'electron'),
+  [resolve(import.meta.dirname, '../tests/fixtures/linux-updater.mjs')], {
+    env: { ...Object.fromEntries(Object.entries(process.env).filter(([name]) =>
+      !/KEY|SECRET|TOKEN|PASSWORD|^NODE_OPTIONS$|^ELECTRON_RUN_AS_NODE$/iu.test(name))), DSH_UBUNTU_UPDATE_RESULT: result },
+    stdio: 'inherit',
+  })
+const timer = setTimeout(() => child.kill('SIGKILL'), 60000)
+try {
+  await new Promise((accept, reject) => {
+    child.once('error', reject)
+    child.once('close', (code, signal) => code === 0 ? accept() : reject(new Error(`Ubuntu updater test failed: ${code ?? signal}`)))
+  })
+  process.stdout.write(await readFile(result, 'utf8'))
+} finally { clearTimeout(timer); await rm(root, { recursive: true, force: true }) }
