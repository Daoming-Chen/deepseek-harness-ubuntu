diff --git a/apps/desktop/tests/linux-packaging.spec.ts b/apps/desktop/tests/linux-packaging.spec.ts
new file mode 100644
index 00000000..5b2c2b96
--- /dev/null
+++ b/apps/desktop/tests/linux-packaging.spec.ts
@@ -0,0 +1,31 @@
+/** Ubuntu local packaging stays independent from the upstream signed update channel. */
+import { expect, it } from 'vitest'
+
+it('packages an Ubuntu desktop entry without official update or mandatory policy configuration', async () => {
+  const { default: config } = await import('../electron-builder.linux.config.mjs')
+  expect(config.publish).toBeNull()
+  expect(config.extraMetadata.dshMandatoryUpdatePolicy).toBeUndefined()
+  expect(config.linux.target).toEqual(['deb'])
+  expect(config.linux.desktop.entry.MimeType).toBe('x-scheme-handler/dsh;')
+  expect(config.electronDist).toContain('linux-x64')
+  expect(config.asarUnpack).toContain('**/*.{node,dylib,dll,so,exe}')
+})
+
+import { linuxUpdatePublish } from '../scripts/linux-update-publish.mjs'
+
+it('uses the same generic update protocol with a dedicated stable Ubuntu feed', () => {
+  expect(linuxUpdatePublish({ DSH_DESKTOP_LINUX_UPDATE_URL: 'https://example.com/ubuntu' }))
+    .toEqual({ provider: 'generic', url: 'https://example.com/ubuntu/', channel: 'stable', useMultipleRangeRequest: false })
+  expect(linuxUpdatePublish({})).toBeUndefined()
+})
+
+it.each(['http://example.com', 'https://user:password@example.com', 'https://example.com?key=value', 'https://example.com#fragment', 'file:///tmp/update'])
+('rejects an unsafe production feed %s', (url) => {
+  expect(() => linuxUpdatePublish({ DSH_DESKTOP_LINUX_UPDATE_URL: url })).toThrow()
+})
+
+it('admits only explicit loopback HTTP tests', () => {
+  expect(linuxUpdatePublish({ DSH_DESKTOP_LINUX_UPDATE_URL: 'http://127.0.0.1:3456', DSH_DESKTOP_LINUX_UPDATE_TEST: '1' })?.url)
+    .toBe('http://127.0.0.1:3456/')
+  expect(() => linuxUpdatePublish({ DSH_DESKTOP_LINUX_UPDATE_URL: 'http://example.com', DSH_DESKTOP_LINUX_UPDATE_TEST: '1' })).toThrow()
+})
